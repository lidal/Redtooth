# Adafruit ESP32-C6 Feather: 4 MB flash, logs on the USB-C port
CONFIG_IDF_TARGET="esp32c6"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# 1 ms ticks: the main loop polls the buttons every 5 ms
CONFIG_FREERTOS_HZ=1000

# Bluetooth LE peripheral with NimBLE
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
CONFIG_BT_NIMBLE_EXT_ADV=y

# Keep pairings across power-offs (one for each mode's host, plus spares)
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_MAX_BONDS=6
CONFIG_BT_NIMBLE_MAX_CCCDS=24

# Buffers for the Switch 2 link (63-byte reports every 15 ms), as used by
# ESP32-BLE5-NSController-Emulator
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=30
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=150
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_SIZE=128
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=30
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_SIZE=512
